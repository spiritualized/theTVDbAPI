{
  "name": "spiritualized/thetvdbapi",
  "description": "PHP implementation for the 4th version of the TheTVDb API.",
  "type": "library",
  "minimum-stability": "stable",
  "license": "ISC",
  "authors": [
    {
      "name": "spiritualized",
      "email": "contact@spiritualized.io"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^8.0",
    "symfony/serializer": "^8.1",
    "symfony/property-access": "^8.1",
    "symfony/property-info": "^8.1",
    "phpdocumentor/reflection-docblock": "^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "spiritualized\\TheTVDbAPI\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "spiritualized\\TheTVDbAPI\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
